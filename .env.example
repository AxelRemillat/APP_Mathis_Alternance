# Identifiant et mot de passe de la page de connexion
APP_USER=
APP_PASSWORD=
# Chaîne aléatoire longue pour signer les sessions (optionnel mais recommandé)
SESSION_SECRET=
# Clé OpenAI dédiée à cet outil (mets une limite de dépense sur le projet OpenAI)
OPENAI_API_KEY=
# Modèle utilisé pour l'analyse (rapide et peu cher)
OPENAI_MODEL=gpt-4o-mini
# Contacts des petites structures sans portail de recrutement, en JSON :
# {"<id d'entreprise>":[{"email":"...","role":"...","source":"..."}]}
# Jamais dans le code : le dépôt est public. Variable serveur uniquement,
# servie par /api/contacts, qui exige une session valide.
TARGET_CONTACTS=
# Webhook n8n qui recoit les remarques du drapeau rouge, et le secret qui
# les authentifie (en-tete x-feedback-secret). Jamais dans le code : le
# depot est public, et une URL de webhook connue laisse n importe qui y
# poster. Les deux sont requises : sans elles, la route refuse clairement.
FEEDBACK_WEBHOOK_URL=
FEEDBACK_WEBHOOK_SECRET=
